# Corpus de campo usado por alguns testes de merge_payloads — dados de
# pesquisa de terceiros (61 entrevistas, ~12 MB), nunca versionados. Os
# testes que dependem dele pulam quando ausente (@requires_davi em
# tests/test_linkage.py). Copia de trabalho em case-studies/Projeto_Davi/.
tests/Davi_Projeto_Completo/
tests/.vscode/

# Tool indexes
.gitnexus
.claude

# Generated HTML outputs
*.html
graphs/

# Embedding sidecars — derived from the .syno, regenerable, and large: 113 KB
# for face85 (210 concepts) without vectors, ~17 MB for Social_Acceptance once
# vectors land. Never versioned.
*.embeddings.json

# Credentials — NEVER commit
config.toml
.env
*.env
!.env.example
*.key
*_api_token.txt
*_api_key.txt

# Build artifacts
*.egg-info/
dist/
build/
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# ArcadeDB embedded writes its engine log next to the working directory,
# so running the test suite creates this. Not an artefact anyone edits.
log/

# State written by `synesis-graph serve` and the embedded backend when they are
# run from inside a checkout: the graph itself, the engine's server users, and
# the generated password. `config/synesis-server-password` is plaintext by
# necessity — a Basic header needs the original — so it must never be committed.
databases/
backups/
config/server-users.jsonl*
config/synesis-server-password
config/mcp-config.json

# OS
.DS_Store
Thumbs.db

# Local docs
AGENTS.md
CLAUDE.md
